# Service configuration
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=false
CACHE_TENANT_NAMESPACE=greenwayai-single-tenant
CACHE_TTL_SECONDS=3600
CACHE_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
CACHE_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Carbon intensity providers
ELECTRICITYMAPS_API_KEY=
WATTTIME_API_KEY=

# LLM backend: mock, vllm, or gemini
GREENWAY_BACKEND_MODE=mock
GEMINI_API_KEY=
GREENWAY_LOG_PROMPTS=false
VLLM_BACKEND_URL=http://vllm:8000